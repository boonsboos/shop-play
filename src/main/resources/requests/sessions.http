### Create game session
POST http://localhost:8080/sessions
Content-Type: application/json

{
  "gameId": "1",
  "userId": "1",
  "visibility": 0
}

### Upload end of session picture
< {%
    request.variables.set("sessionId", "35fdabd3-a853-11f0-9709-c6f05388f105")
%}
PATCH http://localhost:8080/sessions/{{sessionId}}/picture
Content-Type: application/json

{
  "pictureUrl": "https://picsum.photos/256/256"
}

### Update session
< {%
    request.variables.set("sessionId", "fd3fb025-af3e-11f0-8e78-f6e891eb1b7a")
%}
PATCH http://localhost:8080/sessions/{{sessionId}}
Content-Type: application/json
Authorization: bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJzY29yZS1wbGF5LXVzZXJzIiwiaXNzIjoiaHR0cHM6Ly9hcGkuY29ubmVjdC1lbi1wbGF5Lm5sIiwidXNlcklkIjo0LCJleHAiOjE3NjEyMjE0ODF9.7PvfikTnHzj7IozfmIEIUl629P2msxM1lx_Lg2Alpjw

{
  "endTime": "{{$isoTimestamp}}",
  "visibility": 2
}

### get scores for session
< {%
    request.variables.set("sessionId", "b010cb2c-ad00-11f0-8bdd-0242ac140003")
%}
GET http://localhost:8080/sessions/{{sessionId}}/scores
Content-Type: application/json

### upload score to session
< {%
    request.variables.set("sessionId", "b010cb2c-ad00-11f0-8bdd-0242ac140003")
%}
POST http://localhost:8080/sessions/{{sessionId}}/scores
Content-Type: application/json

{
  "score": 10.0,
  "turn": 0,
  "sessionPlayer": {
    "userId": 1,
    "guest": "guest2"
  }
}

### get score from specific session
< {%
    request.variables.set("sessionId", "b010cb2c-ad00-11f0-8bdd-0242ac140003")
    request.variables.set("scoreId", "0199fd79-c4cf-7c8c-8730-c4125a171e6d")
%}
GET http://localhost:8080/sessions/{{sessionId}}/scores/{{scoreId}}
Accept: application/json

### update score
< {%
    request.variables.set("sessionId", "b010cb2c-ad00-11f0-8bdd-0242ac140003")
    request.variables.set("scoreId", "0199fd79-c4cf-7c8c-8730-c4125a171e6d")
%}
PATCH http://localhost:8080/sessions/{{sessionId}}/scores/{{scoreId}}
Content-Type: application/json

{
  "score": 100.0,
  "turn": 0
}