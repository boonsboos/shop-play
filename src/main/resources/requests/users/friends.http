# This is for all friends endpoint inside of the users endpoint

### send friend request
< {%
    request.variables.set("userId", 1) // as user 1
    request.variables.set("friendId", 2) // send a friend request to user 2
%}
POST http://localhost:8080/users/{{userId}}/friends
Content-Type: application/json

{
  "friendId": {{friendId}}
}

### get friends
< {%
    request.variables.set("userId", 1) // gets friends for user 1
%}
GET http://localhost:8080/users/{{userId}}/friends
Content-Type: application/json

### accept friend request
< {%
    request.variables.set("userId", 2) // as user 2
    request.variables.set("friendId", 1) // accept friend request from user 1
%}
PATCH http://localhost:8080/users/{{userId}}/friends/{{friendId}}
Content-Type: application/json

{
  "accept": true
}

### deny friend request
< {%
    request.variables.set("userId", 2) // as user 2
    request.variables.set("friendId", 1) // deny friend request from user 1
%}
PATCH http://localhost:8080/users/{{userId}}/friends/{{friendId}}
Content-Type: application/json

{
  "accept": false
}

### remove user as friend
< {%
    request.variables.set("userId", 2) // as user 2
    request.variables.set("friendId", 1) // remove friendship from user 1
%}
DELETE http://localhost:8080/users/{{userId}}/friends/{{friendId}}
Content-Type: application/json

### log in
POST http://localhost:8080/login
Content-Type: application/json

{
  "username": "Bob",
  "email": "bob@connect-play.nl",
  "password": "Pass1234"
}